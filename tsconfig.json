{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "react"]
  },
  "include": [
    "packages/core/**/*.ts",
    "packages/discord/**/*.ts",
    "packages/ui/**/*.ts",
    "packages/ui/**/*.tsx",
    "packages/betterdiscord/**/*.ts",
    "tests/**/*.ts"
  ]
}
