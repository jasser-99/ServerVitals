{
  "name": "servervitals",
  "version": "0.1.0-alpha.3",
  "private": true,
  "description": "Find the servers that have gone quiet.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages tests scripts",
    "format": "prettier --write .",
