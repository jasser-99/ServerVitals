    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:artifacts",
    "validate:vencord": "node scripts/validate-vencord.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:artifacts": "node scripts/test-artifacts.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "esbuild": "^0.25.10",
    "eslint": "^9.39.0",
    "fflate": "^0.8.3",
    "globals": "^16.4.0",
    "playwright": "^1.64.0",
    "prettier": "^3.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0"
  }
}
